# ---- Application ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ---- Database (Supabase Postgres pooler) ----
# Use the connection pooler URL (port 6543) for serverless; direct (5432) for long-running.
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Supabase (Realtime + Storage, used by the Flutter app) ----
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only — used to write notifications & storage

# ---- Google OAuth (SRS §78) ----
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# ---- JWT (backend-issued sessions, SRS §86) ----
JWT_ACCESS_SECRET=<random-64-chars>
JWT_REFRESH_SECRET=<random-64-chars>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Mobile Money providers (SRS §34) ----
MTN_MOMO_API_USER=<uuid>
MTN_MOMO_API_KEY=<key>
MTN_MOMO_SUBSCRIPTION_KEY=<key>
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
ORANGE_MONEY_CLIENT_ID=<id>
ORANGE_MONEY_CLIENT_SECRET=<secret>
ORANGE_MONEY_BASE_URL=https://api.orange.com
PAYMENT_CALLBACK_URL=https://api.shunem.cm/payments/webhook

# ---- Firebase (FCM push, SRS §101) ----
FIREBASE_PROJECT_ID=<project>
FIREBASE_CLIENT_EMAIL=<sa>@<project>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Service fee (SRS §49) ----
SERVICE_FEE_PERCENT=3
